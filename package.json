  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:editor": "tsc -b && vite build --config vite.editor.config.ts",
    "check:bundle": "node scripts/check-game-bundle.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "map:check": "node scripts/map-tools/check.ts",
    "map:pack": "node scripts/map-tools/pack.ts",
    "map:unpack": "node scripts/map-tools/unpack.ts",
    "deploy:check": "npm test && npm run build && vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "description": "Game sinh tồn zombie 3D góc nhìn isometric chạy trên trình duyệt (Phase 1 MVP). Kế hoạch chi tiết trong Zombie_Outbreak_Phase_1_MVP.md.",
